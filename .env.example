# Root .env — used by docker-compose only

# Local PostgreSQL (dev database)
POSTGRES_DB=money_manager
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmpassword
POSTGRES_PORT=5432

# Local MySQL (mirror of production)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=money_manager_mirror
MYSQL_USER=mmuser
MYSQL_PASSWORD=mmpassword
MYSQL_PORT=3306
