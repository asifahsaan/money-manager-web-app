# Backend environment variables
# Copy to .env and fill in values

# Database — PostgreSQL (production runs on Neon)
# Local dev: point at a Neon dev branch, or the local postgres from docker-compose:
#   postgresql://mmuser:mmpassword@localhost:5432/money_manager
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Local mirror — daily copy of DATABASE_URL (npm run mirror:sync). MySQL or SQL Server.
# Leave unset if you don't run the mirror.
MIRROR_DATABASE_URL="mysql://mmuser:mmpassword@localhost:3306/money_manager_mirror"
# SQL Server with Windows login (TCP/IP must be enabled in SQL Server Configuration Manager):
# MIRROR_DATABASE_URL="sqlserver://localhost:1433;database=MoneyManagerMirror;integratedSecurity=true;trustServerCertificate=true"

# JWT
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development

# CORS - frontend URL
FRONTEND_URL="http://localhost:5173"
